# Copiar a .env (ignorado por git) y rellenar. Nunca commitear .env.

# Zona horaria del stack (cron semanal de n8n, fechas del plan)
TZ=America/Guayaquil

# n8n: clave con la que cifra las credenciales guardadas (Telegram, etc.).
# Generar una vez y no cambiarla, o n8n no podrá leer sus credenciales:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# Postgres: superusuario y un usuario por base (n8n, pb_coach).
# Generar cada una con: python -c "import secrets; print(secrets.token_hex(24))"
# Solo se aplican al crear el volumen por primera vez.
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
PB_COACH_DB_PASSWORD=

# LLM
ANTHROPIC_API_KEY=

# Token compartido que n8n envía a pb-coach en cada llamada
PB_COACH_API_TOKEN=
