# Copiar a .env (ignorado por git) y rellenar. Nunca commitear .env.

# Zona horaria del stack (cron semanal de n8n, fechas del plan)
TZ=America/Guayaquil

# n8n: clave con la que cifra las credenciales guardadas (Telegram, etc.).
# Generar una vez y no cambiarla, o n8n no podrá leer sus credenciales:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# LLM
ANTHROPIC_API_KEY=

# Token compartido que n8n envía a pb-coach en cada llamada
PB_COACH_API_TOKEN=
